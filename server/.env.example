# Copiar a .env y completar. Dos servers SQL (solo lectura).
PORT=4610

# INWEB / RRHH — fichadas (FichadasHik.hik.Fichada)
INWEB_SERVER=192.168.1.9
INWEB_NAME=FichadasHik
INWEB_USER=usuario_sql
INWEB_PASSWORD=contraseña_sql
INWEB_ENCRYPT=false
INWEB_TRUST_CERT=true

# GPS / LSGPS — viajes y geocercas (para "Hs en viaje", pendiente)
GPS_SERVER=192.168.1.5
GPS_NAME=IntercambioDB062
GPS_USER=usuario_sql
GPS_PASSWORD=contraseña_sql
GPS_ENCRYPT=false
GPS_TRUST_CERT=true

# API LSGPS (Navixy) — cobertura de choferes y geocercas de Offal
NAVIXY_BASE=https://napi.lsgps.com.ar
NAVIXY_USER=sistemas@offal.com.ar
NAVIXY_PASS=la_contraseña_de_la_api
